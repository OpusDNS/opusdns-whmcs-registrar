{
    "name": "opusdns/php-client",
    "description": "PHP client for the OpusDNS API, generated from the OpenAPI specification",
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.opusdns.com/",
    "support": {
        "email": "support@opusdns.com",
        "docs": "https://developers.opusdns.com/"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "nette/php-generator": "^4.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "symfony/yaml": "^7.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Provides the PSR-18 client and PSR-17 factories that Client::create() uses by default"
    },
    "autoload": {
        "psr-4": {
            "OpusDNS\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpusDNS\\Generator\\": "generator/",
            "OpusDNS\\Client\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "php bin/generate",
        "spec:check": "php bin/spec-sync --check",
        "spec:sync": "php bin/spec-sync",
        "lint": "find src generator -name '*.php' -print0 | xargs -0 -n1 -P4 php -l | grep -v 'No syntax errors' || true",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
